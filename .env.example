# Copy to .env (git ignores it), then fill in. Never commit real values, and never put them
# in an issue or PR. docker compose reads this file for every service.

# Postgres superuser for the airflow, mlflow, and monitoring databases.
POSTGRES_USER=claimfreq
# Required. Letters and digits only: the password is embedded in database URLs.
POSTGRES_PASSWORD=

# Optional Discord webhook for monitoring alerts (docs/contracts.md). Empty = log only.
ALERT_WEBHOOK_URL=

# --- Airflow (only the machine that runs the full stack needs these) ---
# Required. Absolute path of this repository on the host. The DockerOperator tasks mount it
# into the trainer containers, and Docker resolves mount sources on the host, not in Airflow.
HOST_REPO_DIR=
# Required. Generate each once and keep it:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
# Linux only: your user id (`id -u`), so files Airflow writes are yours. Leave empty on macOS.
AIRFLOW_UID=

# Keep secrets, local state, and bulky folders out of every Docker build context, so nothing
# here can be baked into an image layer (and builds stay fast).

# Secrets. `**/` also matches the repo root, so this covers the root file and any nested copy.
**/.env
**/*.env.local
**/.dvc/config.local

# Local environments, caches, and data. .dvc/tmp/ holds DVC's locks and, during a
# `dvc exp run --temp` or a queued experiment, a workspace copy with its own
# .dvc/config.local and .git/config, so the whole folder stays out.
.venv/
.dvc/cache/
.dvc/tmp/
data/
*.db
mlruns/
mlartifacts/
# Python writes one in every folder it imports modules from, so match it at any depth.
**/__pycache__/
.pytest_cache/
.ruff_cache/

# Not needed inside images (the trainer gets .git from the bind mount at run time)
.git/
